<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:tools="http://schemas.android.com/tools" xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- "set a timer / alarm" by voice -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
    <!-- battery reminders come back after the phone restarts -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- v8: calendar and contacts are read only when you ask (the permission prompt appears then); exact alarms are for reminders -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- v9: direct calls, Pragon PA (answer / reject / caller number), AirPods routing -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.ANSWER_PHONE_CALLS" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- closing apps cleanly, brightness, and the app scanner -->
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />
    <uses-permission android:name="android.permission.WRITE_SETTINGS" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" tools:ignore="QueryAllPackagesPermission" />

    <!-- v13: music player (reads the songs on the phone, plays with the screen off), Wi-Fi state for the panel -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- v14: My Files (file manager). "All files access" is granted by the person on Android's own screen; nothing is uploaded. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" tools:ignore="ScopedStorage" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />

    <!-- v15: Phone optimiser. Usage access (granted by the person on Android's own screen) only lets Pragon read each app's cache size. -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions" />

    <!-- lets the app see (and launch) the installed launcher apps -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <!-- Without these two, Android 11+ hides the speech recognizer and float mode says "no speech recognizer" -->
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".PragonApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.Pragon"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".CustomiserActivity"
            android:exported="false"
            android:label="UI customiser"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:hardwareAccelerated="true" />

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="Settings"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".FilesActivity"
            android:exported="false"
            android:label="My Files" />

        <!-- v18: notification monitors (user grants Notification access). Posts only the monitors the user switched on. -->
        <service
            android:name=".PragonNotifyService"
            android:exported="true"
            android:label="Pragon notification monitors"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- v18: Music screen (library, song and player menus, settings) -->
        <activity
            android:name=".MusicActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:label="Music" />

        <!-- v18: video editor -->
        <activity
            android:name=".VideoEditorActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:label="Video editor" />

        <!-- v18: one screen per feature -->
        <activity
            android:name=".DrafterScreen"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout"
            android:launchMode="singleTop"
            android:label="Drafter" />

        <activity
            android:name=".CalculatorScreen"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout"
            android:launchMode="singleTop"
            android:label="Calculator" />

        <activity
            android:name=".MessagesScreen"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout"
            android:launchMode="singleTop"
            android:label="Messages" />

        <activity
            android:name=".NotificationsScreen"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout"
            android:launchMode="singleTop"
            android:label="Notifications" />

        <activity
            android:name=".MapScreen"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout"
            android:launchMode="singleTop"
            android:label="Map" />

        <activity
            android:name=".DirectionsScreen"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout"
            android:launchMode="singleTop"
            android:label="Directions" />

        <activity
            android:name=".RideScreen"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout"
            android:launchMode="singleTop"
            android:label="Book a ride" />

        <activity
            android:name=".CalendarScreen"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout"
            android:launchMode="singleTop"
            android:label="Calendar" />

        <activity
            android:name=".ClockScreen"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout"
            android:launchMode="singleTop"
            android:label="Clock" />

        <activity
            android:name=".CameraScreen"
            android:exported="false"
            android:launchMode="singleTop"
            android:label="Camera" />

        <activity
            android:name=".LensScreen"
            android:exported="false"
            android:launchMode="singleTop"
            android:label="Google Lens" />

        <!-- v18: Tools hub (map, calendar, camera, calculator, Lens, messages, clock) -->
        <activity
            android:name=".ToolsActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout"
            android:launchMode="singleTop"
            android:label="Tools" />

        <activity
            android:name=".OptimiserActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout"
            android:launchMode="singleTop"
            android:label="Optimiser" />

        <!-- v14: Share > Pragon File Dock (text, links, photos, files from any app go into the sidebar's File Dock) -->
        <activity
            android:name=".DockShareActivity"
            android:exported="true"
            android:label="Pragon File Dock"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <activity
            android:name=".PermissionActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <service
            android:name=".MusicService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <service
            android:name=".PragonPAService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <receiver
            android:name=".ReminderReceiver"
            android:exported="false" />

        <activity
            android:name=".ScreenConsentActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <service
            android:name=".ScreenShareService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Float mode: the hovering bubble that listens by voice -->
        <service
            android:name=".FloatService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <service
            android:name=".PragonService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the connection to the user's own Pragon PC so it can control this phone" />
        </service>

        <!-- Battery reminders: watches the battery level only while a reminder is switched on -->
        <service
            android:name=".BatteryReminderService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Watches the battery level to give the user their own low-battery and unplug reminders" />
        </service>

        <service
            android:name=".SidebarService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Shows the user's own edge sidebar with shortcuts over other apps" />
        </service>

        <!-- Local firewall: a VPN that goes nowhere. It only throws away traffic of apps the user picked. -->
        <service
            android:name=".FirewallService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="On-device firewall that blocks the internet for apps the user chose" />
        </service>

        <receiver
            android:name=".BatteryBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".PragonAccessibilityService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- On-device LLM (LiteRT-LM): lets the chat model use the GPU backend. Optional on every phone. -->
        <uses-native-library android:name="libvndksupport.so" android:required="false" />
        <uses-native-library android:name="libOpenCL.so" android:required="false" />
    </application>
</manifest>
